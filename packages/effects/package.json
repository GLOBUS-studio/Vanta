{
  "name": "@vantajs2/effects",
  "version": "0.1.0",
  "description": "Clean-room WebGL2 ambient effects for VantaJS2.",
  "license": "MIT",
  "author": "Yevhen Leonidov",
  "type": "module",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/GLOBUS-studio/Vanta.git",
    "directory": "packages/effects"
  },
  "homepage": "https://github.com/GLOBUS-studio/Vanta#readme",
  "bugs": {
    "url": "https://github.com/GLOBUS-studio/Vanta/issues"
  },
  "keywords": [
    "webgl",
    "webgl2",
    "background",
    "animation",
    "three",
    "vanta"
  ],
  "publishConfig": {
    "access": "public"
  },
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./aurora": {
      "types": "./dist/aurora.d.ts",
      "import": "./dist/aurora.js"
    },
    "./birds": {
      "types": "./dist/birds.d.ts",
      "import": "./dist/birds.js"
    },
    "./cells": {
      "types": "./dist/cells.d.ts",
      "import": "./dist/cells.js"
    },
    "./clouds": {
      "types": "./dist/clouds.d.ts",
      "import": "./dist/clouds.js"
    },
    "./clouds2": {
      "types": "./dist/clouds2.d.ts",
      "import": "./dist/clouds2.js"
    },
    "./dots": {
      "types": "./dist/dots.d.ts",
      "import": "./dist/dots.js"
    },
    "./fog": {
      "types": "./dist/fog.d.ts",
      "import": "./dist/fog.js"
    },
    "./globe": {
      "types": "./dist/globe.d.ts",
      "import": "./dist/globe.js"
    },
    "./halo": {
      "types": "./dist/halo.d.ts",
      "import": "./dist/halo.js"
    },
    "./net": {
      "types": "./dist/net.d.ts",
      "import": "./dist/net.js"
    },
    "./rings": {
      "types": "./dist/rings.d.ts",
      "import": "./dist/rings.js"
    },
    "./ripple": {
      "types": "./dist/ripple.d.ts",
      "import": "./dist/ripple.js"
    },
    "./topology": {
      "types": "./dist/topology.d.ts",
      "import": "./dist/topology.js"
    },
    "./trunk": {
      "types": "./dist/trunk.d.ts",
      "import": "./dist/trunk.js"
    },
    "./waves": {
      "types": "./dist/waves.d.ts",
      "import": "./dist/waves.js"
    }
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE.md"
  ],
  "sideEffects": false,
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "@vantajs2/core": "workspace:*",
    "@vantajs2/three": "workspace:*"
  },
  "peerDependencies": {
    "three": ">=0.160.0"
  },
  "devDependencies": {
    "@types/three": "^0.187.0",
    "three": "^0.187.0"
  },
  "tsup": {
    "entry": [
      "src/index.ts",
      "src/aurora.ts",
      "src/birds.ts",
      "src/cells.ts",
      "src/clouds.ts",
      "src/clouds2.ts",
      "src/dots.ts",
      "src/fog.ts",
      "src/globe.ts",
      "src/halo.ts",
      "src/net.ts",
      "src/rings.ts",
      "src/ripple.ts",
      "src/topology.ts",
      "src/trunk.ts",
      "src/waves.ts"
    ],
    "format": [
      "esm"
    ],
    "dts": true,
    "clean": true,
    "sourcemap": true,
    "target": "es2022",
    "treeshake": true
  }
}
