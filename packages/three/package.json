{
  "name": "@vantajs2/three",
  "version": "0.1.0",
  "description": "Three.js adapter for VantaJS2: WebGL2 renderer setup, fullscreen shader helpers, and deep disposal.",
  "license": "MIT",
  "author": "Yevhen Leonidov",
  "type": "module",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/GLOBUS-studio/Vanta.git",
    "directory": "packages/three"
  },
  "homepage": "https://github.com/GLOBUS-studio/Vanta#readme",
  "bugs": {
    "url": "https://github.com/GLOBUS-studio/Vanta/issues"
  },
  "keywords": [
    "webgl",
    "webgl2",
    "three",
    "shader",
    "background",
    "vanta"
  ],
  "publishConfig": {
    "access": "public"
  },
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE.md"
  ],
  "sideEffects": false,
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "peerDependencies": {
    "three": ">=0.160.0"
  },
  "devDependencies": {
    "@types/three": "^0.187.0",
    "three": "^0.187.0"
  },
  "tsup": {
    "entry": [
      "src/index.ts"
    ],
    "format": [
      "esm"
    ],
    "dts": true,
    "clean": true,
    "sourcemap": true,
    "target": "es2022",
    "treeshake": true
  }
}
